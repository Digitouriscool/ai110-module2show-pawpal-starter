classDiagram
    class Owner {
        +string name
        +int available_minutes
        +list~string~ preferences
        +list~Pet~ pets
        +add_pet(Pet pet)
        +remove_pet(string pet_name) Pet
        +get_pet(string pet_name) Pet
        +get_all_tasks(bool include_completed) list
        +update_preferences(list preferences)
        +set_available_time(int minutes)
    }

    class Pet {
        +string name
        +string species
        +string breed
        +int age
        +list~Task~ tasks
        +care_needs list
        +add_task(Task task)
        +add_care_need(Task task)
        +remove_task(string description) Task
        +get_tasks() list
        +get_pending_tasks() list
        +get_profile() string
    }

    class Task {
        +string description
        +int duration_minutes
        +string frequency
        +string priority
        +string preferred_time
        +bool completed
        +date due_date
        +title string
        +mark_complete()
        +mark_incomplete()
        +get_priority_score() int
        +is_required_today() bool
        +create_next_occurrence() Task
        +describe() string
    }

    class Scheduler {
        +string start_time
        +dict priority_weights
        +get_tasks_from_owner(Owner owner) list
        +sort_tasks(list pet_tasks) list
        +sort_by_time(list pet_tasks) list
        +filter_tasks(list pet_tasks, bool completed, string pet_name) list
        +detect_conflicts(list pet_tasks) list
        +fits_available_time(Task task, int remaining_minutes) bool
        +build_schedule(Owner owner, Pet pet, list tasks) DailySchedule
        +explain_choice(Task task) string
        +complete_task(Owner owner, string pet_name, string task_description) Task
    }

    class DailySchedule {
        +string date
        +Owner owner
        +list scheduled_items
        +list skipped_tasks
        +list conflict_warnings
        +add_item(dict item)
        +add_skipped_task(tuple pet_task)
        +total_scheduled_minutes() int
        +format_plan() string
    }

    Owner "1" --> "0..*" Pet : manages
    Pet "1" --> "0..*" Task : stores
    Owner "1" --> "0..*" Task : aggregates via pets
    Scheduler --> Owner : retrieves tasks from
    Scheduler --> DailySchedule : creates
    Scheduler --> Task : sorts filters completes
    DailySchedule --> Owner : belongs to
    DailySchedule "1" --> "0..*" Task : references in scheduled_items
